# Environment Configuration Template
PROJECT_NAME="VIT Dance Club Studio Booking"
ENVIRONMENT="production"

# PostgreSQL Connection String
# Example for Render / Neon: postgresql+psycopg2://user:password@ep-project.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5433/vit_dance_booking"

# Cryptographic Secret Key for JWT Token Generation (Generate with `openssl rand -hex 32`)
SECRET_KEY="generate-a-secure-random-256-bit-key-for-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed CORS Origins (Vercel Frontend URL and Localhost)
CORS_ORIGINS=["https://vit-dance-booking.vercel.app","http://localhost:5173","http://127.0.0.1:5173"]

# Cookie & Session Security (Set to True in HTTPS Production)
COOKIE_NAME="vit_dance_session"
COOKIE_SECURE=true
COOKIE_SAMESITE="lax"

# Operational Defaults (Asia/Kolkata IST)
TIMEZONE="Asia/Kolkata"
ADVANCE_BOOKING_HOURS=72
DEFAULT_OPENING_TIME="09:00"
DEFAULT_CLOSING_TIME="19:00"
DEFAULT_SLOT_INTERVAL_MINUTES=30
DEFAULT_MAX_DURATION_MINUTES=120

# Optional Bootstrap Administrator Credentials
BOOTSTRAP_ADMIN_USERNAME=""
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""
